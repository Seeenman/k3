# k3 developer workflow. See PLAN.md §7 and the README "Development" notes.

ID  := k3
PKG := package
OUT := $(PKG)/contents/code/main.js
# Concatenation order matters: later files may use earlier ones at load time.
SRC := src/config.js src/tree.js src/kwin.js src/commands.js src/main.js
KEYS_FILE ?= $(HOME)/.config/kglobalshortcutsrc

# Nested KWin session (make nested). HEADLESS=1 renders to a virtual
# framebuffer instead of opening a window on the host desktop.
NESTED_SOCKET := k3-nested
NESTED_SIZE   := --width 1600 --height 900 --output-count 2
NESTED_ENV     = DBUS_SESSION_BUS_ADDRESS='$(shell cat .dev/bus 2>/dev/null)' WAYLAND_DISPLAY=$(NESTED_SOCKET)
NESTED_QDBUS   = $(NESTED_ENV) qdbus6 org.kde.KWin /Scripting org.kde.kwin.Scripting

.PHONY: build install uninstall enable disable reload logs check-keys test \
        nested nested-stop nested-load nested-run nested-key clean

build: $(OUT)

$(OUT): $(SRC) Makefile
	@mkdir -p $(dir $@)
	{ echo "// GENERATED by make from src/ - do not edit."; \
	  echo "var K3_BUILD = \"$$(date +%FT%T)\";"; \
	  cat $(SRC); } > $@

# --- live session -----------------------------------------------------------

install: build
	kpackagetool6 --type=KWin/Script --install $(PKG) 2>/dev/null \
	  || kpackagetool6 --type=KWin/Script --upgrade $(PKG)

uninstall: disable
	kpackagetool6 --type=KWin/Script --remove $(ID)

enable:
	kwriteconfig6 --file kwinrc --group Plugins --key $(ID)Enabled true
	qdbus6 org.kde.KWin /KWin reconfigure

disable:
	kwriteconfig6 --file kwinrc --group Plugins --key $(ID)Enabled false
	qdbus6 org.kde.KWin /KWin reconfigure

# Upgrade the installed package and (re)start the script in the running KWin.
# Scripting.start only loads enabled plugins, so this enables k3 too. A script
# that throws while loading just disappears, hence the final check.
reload: install
	kwriteconfig6 --file kwinrc --group Plugins --key $(ID)Enabled true
	qdbus6 org.kde.KWin /Scripting org.kde.kwin.Scripting.unloadScript $(ID)
	qdbus6 org.kde.KWin /Scripting org.kde.kwin.Scripting.start
	@qdbus6 org.kde.KWin /Scripting org.kde.kwin.Scripting.isScriptLoaded $(ID) | grep -q true \
	  || { echo "k3 did not load; see make logs"; exit 1; }

logs:
	journalctl --user -f -o cat -u plasma-kwin_wayland | grep --line-buffered '\[k3\]'

# KDE lets two actions share a key (which one fires is then undefined), so
# list every key a k3 shortcut shares with another action.
check-keys:
	@awk -f tools/check-keys.awk $(KEYS_FILE)

# --- tests ------------------------------------------------------------------

# /usr/bin/qmltestrunner is the Qt 5 one; without QT_FORCE_STDERR_LOGGING the
# results go to the journal instead of the terminal.
test:
	QT_QPA_PLATFORM=offscreen QT_FORCE_STDERR_LOGGING=1 \
	  /usr/lib/qt6/bin/qmltestrunner -input test

# --- nested KWin ------------------------------------------------------------

# Isolated config (.dev/config) and D-Bus session; kwin output -> .dev/nested.log
nested: build
	@mkdir -p .dev/config
	-XDG_CONFIG_HOME=$(CURDIR)/.dev/config QT_FORCE_STDERR_LOGGING=1 \
	  dbus-run-session -- sh -c 'echo "$$DBUS_SESSION_BUS_ADDRESS" > .dev/bus; \
	  exec kwin_wayland --socket $(NESTED_SOCKET) --xwayland --no-lockscreen \
	    $(if $(HEADLESS),--virtual) $(NESTED_SIZE)' > .dev/nested.log 2>&1

nested-stop:
	-pkill -f '^kwin_wayland --socket $(NESTED_SOCKET)'

# (Re)load the freshly built script into the nested KWin. Not under the name
# "k3": Scripting.start unloads any script named after an installed plugin
# that the (nested) config doesn't enable.
nested-load: build
	-$(NESTED_QDBUS).unloadScript $(ID)-nested
	$(NESTED_QDBUS).loadScript $(CURDIR)/$(OUT) $(ID)-nested
	$(NESTED_QDBUS).start

# make nested-run CMD=konsole
nested-run:
	$(NESTED_ENV) XDG_CONFIG_HOME=$(CURDIR)/.dev/config $(CMD) >/dev/null 2>&1 &

# make nested-key K=k3-hello
nested-key:
	$(NESTED_ENV) qdbus6 org.kde.kglobalaccel /component/kwin \
	  org.kde.kglobalaccel.Component.invokeShortcut "$(K)"

clean:
	rm -f $(OUT)
